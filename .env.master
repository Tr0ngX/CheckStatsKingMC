# ==================================================
# MASTER NODE ENVIRONMENT CONFIGURATION (.env.master)
# Dùng để Copy & Paste vào Render Environment của Master (kingmc-master)
# ==================================================

# 1. Chế độ hoạt động bắt buộc cho Master (Quản lý Queue + Dashboard):
BOT_ROLE=master

# 2. Secret kết nối bảo mật với Worker & Đăng nhập Web Dashboard:
WORKER_SECRET=my_super_secret_key_123

# 3. Danh sách URL các Worker Nodes (cách nhau bởi dấu phẩy):
# Cập nhật thêm URL worker mới của bạn vào đây:
WORKER_URLS=https://checkstatskingmc-2onp.onrender.com,https://kingmc-worker-1.onrender.com

# 4. Cấu hình Discord Bot (Nếu có):
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ADMIN_ID=

# 5. Cấu hình Groq AI Chat (Tùy chọn):
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# 6. MongoDB Atlas (Lưu trữ lịch sử số dư & quản lý Worker động - Tùy chọn):
MONGODB_URI=

# 7. Phiên bản Node.js:
NODE_VERSION=20
