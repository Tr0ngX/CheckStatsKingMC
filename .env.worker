# ==================================================
# WORKER NODE ENVIRONMENT CONFIGURATION (.env.worker)
# Dùng để Copy & Paste vào Render Environment của Worker (VD: checkstatskingmc-2onp)
# ==================================================

# 1. Chế độ hoạt động bắt buộc cho Worker:
BOT_ROLE=worker

# 2. Secret kết nối bảo mật với Master (Phải khớp 100% với WORKER_SECRET trên kingmc-master):
WORKER_SECRET=my_super_secret_key_123

# 3. URL của Master Node để Worker báo cáo trạng thái, ping keep-alive và gửi cảnh báo:
MASTER_URL=https://kingmc-master.onrender.com

# 4. Cấu hình máy chủ KingMC:
MC_SERVER_HOSTS=sgp.kingmc.vn,kingmc.vn
MC_SERVER_PORT=25565
MC_AUTH_TYPE=offline

# 5. Thời gian timeout tối đa cho một thao tác (ms):
BOT_CHECK_TIMEOUT=15000

# 6. Phiên bản Node.js khuyến nghị trên Render:
NODE_VERSION=20
